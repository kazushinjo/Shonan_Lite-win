diff --git a/lib/ldpc_decoder/portable_vla.hh b/lib/ldpc_decoder/portable_vla.hh
new file mode 100644
index 0000000..afc9e47
--- /dev/null
+++ b/lib/ldpc_decoder/portable_vla.hh
@@ -0,0 +1,22 @@
+/* -*- c++ -*- */
+/*
+ * MSVC does not support C99/GNU variable-length arrays (VLAs), which this
+ * LDPC decoder code otherwise relies on heavily for small per-check-node
+ * scratch buffers sized at runtime. GCC/Clang (the Linux/Pi5 build) keep
+ * using real VLAs (fast stack allocation, unaffected); MSVC falls back to
+ * a heap-allocated std::vector with the same effective lifetime (function
+ * scope). This only affects the Windows dev-environment build.
+ */
+#ifndef GR_DVBS2RX_PORTABLE_VLA_HH
